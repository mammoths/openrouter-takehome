// Deployment template: configure your own D1 database and R2 bucket before deploying.
{
  "name": "openrouter-takehome",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openrouter-takehome",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VIDEO_ARCHIVE",
      "bucket_name": "openrouter-takehome-videos"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
